{
  "name": "Tab Capture - Recorder",
  "description": "Records the current tab in an offscreen document.",
  "version": "1",
  "key": "",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "incognito": "split",
  "permissions": ["tabs", "tabCapture", "offscreen", "activeTab", "notifications"],
  "host_permissions": ["<all_urls>"]
}